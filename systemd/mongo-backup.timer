# Installed and enabled by deploy.sh. See: systemctl --user list-timers
[Unit]
Description=Weekly encrypted MongoDB backup

[Timer]
OnCalendar=Sun *-*-* 03:30:00
RandomizedDelaySec=15min
# If the server was off at that time, run the backup as soon as it's back.
Persistent=true

[Install]
WantedBy=timers.target
