[Unit]
Description=Nginx Reverse Proxy
After=backend.service frontend.service mcp.service
Requires=backend.service frontend.service
# Optional: started first when deployed, so the name "mcp" resolves
Wants=mcp.service

[Container]
Image=docker.io/library/nginx:1.31.1-alpine-slim
Pod=webpage.pod
ContainerName=nginx
Volume=%h/.config/containers/nginx:/etc/nginx:ro,Z
Volume=%h/.config/containers/certs:/etc/nginx/certs:ro,Z
# Uploaded images, served directly by nginx (read-only). Lowercase z: the
# volume is shared with the backend container.
Volume=backend-uploads.volume:/srv/uploads:ro,z
PublishPort=443:443
Network=app.network

[Service]
TimeoutStartSec=900

[Install]
WantedBy=default.target