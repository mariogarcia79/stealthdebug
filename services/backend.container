[Unit]
Description=API Backend Service
After=mongo.service
Requires=mongo.service

[Container]
Image=localhost/backend:latest
Pod=webpage.pod
ContainerName=backend
EnvironmentFile=%h/.config/containers/env/backend.env
# Lowercase z: shared with the nginx container, which serves the files.
# U: Podman chowns the volume to the container's user (node, uid 1000) on
# start. The backend runs as non-root, and files written by older root-run
# images (or restored with `podman volume import`) would otherwise be
# read-only for it: uploads and resized copies fail with EACCES.
Volume=backend-uploads.volume:/app/public/uploads:z,U
Network=app.network

[Service]
TimeoutStartSec=900

[Install]
WantedBy=default.target