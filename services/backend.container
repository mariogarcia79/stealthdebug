[Unit]
Description=API Backend Service
After=mongo.service
Requires=mongo.service

[Container]
Image=localhost/backend:latest
Pod=webpage.pod
ContainerName=backend
EnvironmentFile=%h/.config/containers/env/backend.env
# Lowercase z: shared with the nginx container, which serves the files.
Volume=backend-uploads.volume:/app/public/uploads:z
Network=app.network

[Service]
TimeoutStartSec=900

[Install]
WantedBy=default.target